{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/lexform-app/browser",
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.lexform.uz" }], "destination": "https://lexform.uz/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)\\.(js|css|woff2|png|svg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/my", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
